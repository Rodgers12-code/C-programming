#include <stdio.h>

int main(void)
{
    FILE *fp;
    double amount;
    double total = 0.0;

    fp = fopen("sales.txt", "r");
    if (fp == NULL)
    {
        printf("Error: could not open sales.txt\n");
        return 1;
    }

    while (fscanf(fp, "%lf", &amount) == 1)
    {
        total += amount;
    }

    fclose(fp);

    printf("Total sales for the day: KSh. %.2f\n", total);

    return 0;
}
